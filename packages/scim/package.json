{
  "name": "@cinaauth/scim",
  "version": "1.7.3",
  "description": "SCIM plugin for CinaAuth",
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.cinagroup.com/docs/plugins/scim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinagroup/cinaauth.git",
    "directory": "packages/scim"
  },
  "author": "CinaGroup",
  "contributors": [
    "Jonathan Samines"
  ],
  "keywords": [
    "auth",
    "scim",
    "typescript",
    "cinaauth"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest",
    "coverage": "vitest run --coverage --coverage.provider=istanbul"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./legacy": {
      "dev-source": "./src/legacy/index.ts",
      "types": "./dist/legacy/index.d.mts",
      "default": "./dist/legacy/index.mjs"
    },
    "./legacy/client": {
      "dev-source": "./src/legacy/client.ts",
      "types": "./dist/legacy/client.d.mts",
      "default": "./dist/legacy/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ],
      "legacy": [
        "./dist/legacy/index.d.mts"
      ],
      "legacy/client": [
        "./dist/legacy/client.d.mts"
      ]
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cinaauth/core": "workspace:*",
    "@cinaauth/kysely-adapter": "workspace:*",
    "@cinaauth/sso": "workspace:*",
    "@cinaauth/test-utils": "workspace:*",
    "kysely": "catalog:",
    "oauth2-mock-server": "^9.0.0",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@cinaauth/core": "workspace:^",
    "@better-auth/utils": "catalog:",
    "cinaauth": "workspace:^",
    "better-call": "catalog:"
  }
}
